# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Solo backend (API routes / cron). NUNCA exponer con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp del administrador/dueño (formato internacional sin + ni espacios, ej: 521234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=521234567890

# Secreto compartido para autorizar al Cron Job a llamar /api/cron/check-alerts
CRON_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# URL pública del sitio (usada en metadata / enlaces)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
